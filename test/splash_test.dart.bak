import 'package:buslink/app/bootstrapper.dart';
import 'package:buslink/app/startup.dart';
import 'package:buslink/utils/app_theme.dart';
import 'package:buslink/views/splash/route_painter.dart';
import 'package:buslink/views/splash/splash_screen.dart';
import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';

import 'helpers/app_fonts.dart';

Widget _app(Widget child) => MaterialApp(
      theme: AppTheme.lightTheme,
      home: Material(child: child),
    );

void main() {
  setUpAll(loadAppFonts);

  group('the splash timeline', () {
    test('the bus does not start until the entrance is under way', () {
      expect(SplashTimeline.cycle(0.0), isNull);
      expect(SplashTimeline.cycle(0.99), isNull);
      expect(SplashTimeline.cycle(1.0), 0.0);
    });

    test('a journey takes 3.6 seconds and then starts again', () {
      expect(SplashTimeline.cycle(1.0 + 1.8), closeTo(0.5, 1e-9));
      expect(SplashTimeline.cycle(1.0 + 3.6 + 0.9), closeTo(0.25, 1e-9));
      expect(SplashTimeline.cycle(1.0 + 3.6 * 3 + 1.8), closeTo(0.5, 1e-9));
    });

    test('the entrance eases in over the first second and a half', () {
      final start = SplashTimeline.intro(0);
      expect(start.logo, 0);
      expect(start.word, 0);
      expect(start.message, 0);
      final end = SplashTimeline.intro(SplashTimeline.introEnd);
      expect(end.logo, 1);
      expect(end.word, 1);
      expect(end.route, 1);
      expect(end.message, 1);
    });

    test('Kandy is about 47 percent of the way along the road', () {
      expect(RoutePainter.kandyFraction, closeTo(0.469, 0.01));
    });
  });

  group('SplashScreen', () {
    testWidgets('shows the name and a plain status line', (tester) async {
      await tester.pumpWidget(_app(const SplashScreen()));
      await tester.pump(const Duration(seconds: 2));
      expect(find.text('BusLink'), findsOneWidget);
      expect(find.textContaining('Getting things ready', findRichText: true),
          findsOneWidget);
      expect(find.text('Still getting ready'), findsNothing);
    });

    testWidgets('keeps animating without errors through several journeys',
        (tester) async {
      await tester.pumpWidget(_app(const SplashScreen()));
      for (var i = 0; i < 12; i++) {
        await tester.pump(const Duration(milliseconds: 700));
      }
      expect(tester.takeException(), isNull);
    });

    testWidgets('slow: says it is slow, in words', (tester) async {
      await tester.pumpWidget(_app(const SplashScreen(slow: true)));
      await tester.pump(const Duration(seconds: 2));
      expect(find.text('Still getting ready'), findsOneWidget);
      expect(find.textContaining('connection looks slow'), findsOneWidget);
      expect(find.textContaining('Getting things ready', findRichText: true),
          findsNothing);
    });

    testWidgets('a custom status line is shown', (tester) async {
      await tester
          .pumpWidget(_app(const SplashScreen(status: 'Loading your profile')));
      await tester.pump(const Duration(seconds: 2));
      expect(find.textContaining('Loading your profile', findRichText: true),
          findsOneWidget);
    });

    testWidgets('when the phone asks for less motion, nothing moves',
        (tester) async {
      tester.platformDispatcher.accessibilityFeaturesTestValue =
          const FakeAccessibilityFeatures(disableAnimations: true);
      addTearDown(
          tester.platformDispatcher.clearAccessibilityFeaturesTestValue);

      await tester.pumpWidget(_app(const SplashScreen()));
      // With no ticker running, the screen settles. A moving one never would.
      await tester.pumpAndSettle();
      expect(find.text('BusLink'), findsOneWidget);
      expect(find.textContaining('Getting things ready', findRichText: true),
          findsOneWidget);
    });

    testWidgets('is read out as one thing', (tester) async {
      final handle = tester.ensureSemantics();
      await tester.pumpWidget(_app(const SplashScreen()));
      await tester.pump(const Duration(seconds: 2));
      expect(find.bySemanticsLabel('Getting things ready'), findsOneWidget);
      handle.dispose();
    });
  });

  group('StartupFailedScreen', () {
    testWidgets('says what happened and has one big Try again button',
        (tester) async {
      var retries = 0;
      await tester
          .pumpWidget(_app(StartupFailedScreen(onRetry: () => retries++)));
      expect(find.text("We couldn't start BusLink"), findsOneWidget);
      expect(find.textContaining('Check your internet connection'),
          findsOneWidget);
      await tester.tap(find.text('Try again'));
      expect(retries, 1);
      final size =
          tester.getSize(find.byWidgetPredicate((w) => w is FilledButton));
      expect(size.height, greaterThanOrEqualTo(48));
    });
  });

  group('AppBootstrapper', () {
    testWidgets('shows the splash, then the app when start-up is done',
        (tester) async {
      await tester.pumpWidget(AppBootstrapper(
        startup: AppStartup([
          StartupStep('work',
              () => Future<void>.delayed(const Duration(milliseconds: 300))),
        ]),
        readyBuilder: (_) => const Text('the app'),
      ));
      await tester.pump(const Duration(milliseconds: 100));
      expect(find.text('BusLink'), findsOneWidget);
      expect(find.text('the app'), findsNothing);

      await tester.pump(const Duration(milliseconds: 400));
      expect(find.text('the app'), findsOneWidget);
      expect(find.textContaining('Getting things ready', findRichText: true),
          findsNothing);
    });

    testWidgets('says so when start-up is slow, then still opens',
        (tester) async {
      await tester.pumpWidget(AppBootstrapper(
        startup: AppStartup(
          [
            StartupStep('work',
                () => Future<void>.delayed(const Duration(milliseconds: 600)))
          ],
          slowAfter: const Duration(milliseconds: 200),
        ),
        readyBuilder: (_) => const Text('the app'),
      ));
      await tester.pump(const Duration(milliseconds: 300));
      await tester.pump(const Duration(milliseconds: 400));
      expect(find.text('Still getting ready'), findsOneWidget);

      await tester.pump(const Duration(milliseconds: 500));
      expect(find.text('the app'), findsOneWidget);
    });

    testWidgets('a failed start shows Try again, and Try again works',
        (tester) async {
      var attempts = 0;
      await tester.pumpWidget(AppBootstrapper(
        startup: AppStartup([
          StartupStep('firebase', () async {
            attempts++;
            if (attempts == 1) throw StateError('no network');
          }),
        ]),
        readyBuilder: (_) => const Text('the app'),
      ));
      await tester.pump(const Duration(milliseconds: 50));
      expect(find.text("We couldn't start BusLink"), findsOneWidget);
      expect(find.text('the app'), findsNothing);

      await tester.tap(find.text('Try again'));
      await tester.pump(const Duration(milliseconds: 50));
      await tester.pump(const Duration(milliseconds: 50));
      expect(attempts, 2);
      expect(find.text('the app'), findsOneWidget);
    });
  });
}
