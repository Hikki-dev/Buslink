rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // NOTE: this admin email is a leftover from early development. Remove it
    // once your own admin account has role == 'admin' (see SECURITY.md).
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'admin@buslink.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isConductor() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'conductor'
      );
    }

    // A conductor may change a ticket as before, but the boarding stamp
    // (boardedAt / boardedBy) can be set ONCE, and boardedBy must be them.
    function boardingStampIsSafe() {
      let touched = request.resource.data.diff(resource.data).affectedKeys();
      return !touched.hasAny(['boardedAt', 'boardedBy'])
          || (!('boardedAt' in resource.data)
              && request.resource.data.boardedBy == request.auth.uid);
    }

    // A passenger may update their own ticket (a refund request, repairing a
    // missing trip detail) but never who it belongs to, what it costs, which
    // seats it covers, whether it has boarded, or whether it has been PAID.
    // Payment is confirmed by the server after it asks Stripe (api/confirm_booking
    // and the webhook), which writes with admin rights and skips these rules.
    function ownerUpdateIsSafe() {
      let touched = request.resource.data.diff(resource.data).affectedKeys();
      return !touched.hasAny(['userId', 'tripId', 'totalAmount', 'seatNumbers',
                              'boardedAt', 'boardedBy', 'paymentIntentId', 'confirmedAt'])
          && (!touched.hasAny(['status'])
              || (resource.data.status == 'confirmed'
                  && request.resource.data.status == 'refund_requested'));
    }

    // A passenger can start a ticket only as 'pending'. A ticket that is
    // already confirmed (a cash ticket sold at the door) comes from a
    // conductor or an admin.
    function newTicketIsSafe() {
      return request.resource.data.get('status', 'pending') == 'pending'
          || isConductor() || isAdmin();
    }

    // --- RULES ---

    // User profiles. A person can create their own profile only as a
    // customer, and can never change their own role. Only an admin sets roles.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isConductor();
      allow create: if isAdmin() ||
        (isOwner(userId) &&
         request.resource.data.get('role', 'customer') == 'customer');
      allow update: if isAdmin() ||
        (isOwner(userId) &&
         request.resource.data.get('role', 'customer') ==
           resource.data.get('role', 'customer'));
      allow delete: if isOwner(userId) || isAdmin();

      // favorite_routes and any other subcollection. It must be written as
      // /{subcollection}/{document=**}: a bare /{document=**} also matches
      // the user document itself and would let people write their own role.
      match /{subcollection}/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Trips: public read. Admins and conductors manage them. Any signed-in
    // user may change ONLY the booked seat lists (that is how booking works).
    match /trips/{tripId} {
      allow read: if true;
      allow update: if isAdmin() || isConductor() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['bookedSeatNumbers', 'bookedSeats'])
      );
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    // Routes and schedules: public read, admin write.
    match /routes/{routeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tickets
    match /tickets/{ticketId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || isAdmin() || isConductor()
      );
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        newTicketIsSafe();
      allow update: if isAdmin()
        || (isConductor() && boardingStampIsSafe())
        || (request.auth != null &&
            resource.data.userId == request.auth.uid &&
            ownerUpdateIsSafe());
    }

    // Feedback: any signed-in user can send, admins read.
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
    }

    // Refunds: users create their own, admins review.
    match /refunds/{refundId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    // Refund transactions: admin only.
    match /refund_transactions/{txnId} {
      allow read, write: if isAdmin();
    }

    // Notifications. A person can create their own (for example "refund
    // received"). Conductors and admins can create them for passengers (trip
    // delayed or cancelled). People read and mark their own as read.
    match /notifications/{notificationId} {
      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid ||
        isConductor() ||
        isAdmin()
      );
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
